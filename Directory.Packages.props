<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Runtime Dependencies">
    <!-- Span<T>/ReadOnlySpan<T> for the netstandard2.0 target (built in on net8.0+). -->
    <PackageVersion Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup Label="Adapter Dependencies">
    <PackageVersion Include="QuestPDF" Version="2024.12.0" />
    <PackageVersion Include="itext7" Version="8.0.5" />
    <PackageVersion Include="itext7.bouncy-castle-adapter" Version="8.0.5" />
    <!-- PDFium-based rasterizer for the visual comparison engine. -->
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <!-- Chart drawing shared by the real adapters. -->
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <!-- QuestPDF 2023.x does not bundle the SkiaSharp/HarfBuzz Linux native assets (2024 does),
         so the runtime host supplies them on that line. Matched to QuestPDF 2023.12.6's
         SkiaSharp 2.88.7 / HarfBuzzSharp 7.3.0.1. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.7" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.1" />
  </ItemGroup>

  <ItemGroup Label="Test Dependencies">
    <!-- Test Framework -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />

    <!-- Test Utilities -->
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- Architecture Tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
