<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>FluentPdf.Adapters.PdfSharp</RootNamespace>
    <AssemblyName>FluentPdf.Adapters.PdfSharp</AssemblyName>
    <Description>PDFsharp/MigraDoc renderer adapter for FluentPdf: renders the agnostic document model to PDF with the MIT-licensed, fully managed PDFsharp family (no native dependencies).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared brings the chart/font support and, transitively, the FluentPdf core package. -->
    <ProjectReference Include="../FluentPdf.Adapters.Shared/FluentPdf.Adapters.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>

</Project>
