<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>FluentPdf.Adapters.QuestPdf</RootNamespace>
    <AssemblyName>FluentPdf.Adapters.QuestPdf</AssemblyName>
    <Description>QuestPDF renderer adapter for FluentPdf: renders the agnostic document model to PDF with QuestPDF.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared brings the chart/font support and, transitively, the FluentPdf core package. -->
    <ProjectReference Include="../FluentPdf.Adapters.Shared/FluentPdf.Adapters.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

</Project>
