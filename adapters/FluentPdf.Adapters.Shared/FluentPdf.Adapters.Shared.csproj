<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single target so the embedded fonts ship once (not duplicated per TFM); usable from
         every modern consumer. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>FluentPdf.Adapters.Shared</RootNamespace>
    <AssemblyName>FluentPdf.Adapters.Shared</AssemblyName>
    <Description>Shared support for FluentPdf renderer adapters: the embedded Liberation Sans font and the common table/chart visual theme. Pure managed — no native dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application is the 'FluentPdf' package; Domain/Kernel come through it (bundled inside). -->
    <ProjectReference Include="../../src/FluentPdf.Application/FluentPdf.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Regular + bold only; italics are synthesised by the adapters to keep the package small. -->
    <EmbeddedResource Include="Fonts/LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Fonts/LiberationSans-Bold.ttf" />
  </ItemGroup>

</Project>
