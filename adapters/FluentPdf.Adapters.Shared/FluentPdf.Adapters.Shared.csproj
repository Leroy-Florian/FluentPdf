<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>FluentPdf.Adapters.Shared</RootNamespace>
    <AssemblyName>FluentPdf.Adapters.Shared</AssemblyName>
    <Description>Shared support for FluentPdf renderer adapters: the embedded Liberation Sans font, a SkiaSharp chart renderer and the common table/chart visual theme.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application is the 'FluentPdf' package; Domain/Kernel come through it (bundled inside). -->
    <ProjectReference Include="../../src/FluentPdf.Application/FluentPdf.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts/LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Fonts/LiberationSans-Bold.ttf" />
    <EmbeddedResource Include="Fonts/LiberationSans-Italic.ttf" />
    <EmbeddedResource Include="Fonts/LiberationSans-BoldItalic.ttf" />
  </ItemGroup>

</Project>
