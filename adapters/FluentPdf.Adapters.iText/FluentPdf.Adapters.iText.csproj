<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>FluentPdf.Adapters.IText</RootNamespace>
    <AssemblyName>FluentPdf.Adapters.iText</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- itext7.bouncy-castle-adapter pulls a transitively-flagged BouncyCastle build. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FluentPdf.Application/FluentPdf.Application.csproj" />
    <ProjectReference Include="../../src/FluentPdf.Domain/FluentPdf.Domain.csproj" />
    <ProjectReference Include="../../src/FluentPdf.Kernel/FluentPdf.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext7" />
    <PackageReference Include="itext7.bouncy-castle-adapter" />
  </ItemGroup>

</Project>
