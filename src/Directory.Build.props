<Project>
  <!-- Inherit the repository-wide settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Library-agnostic core: consumable from .NET 5 through .NET 10 (and beyond) via
         netstandard2.0, with modern targets for newer language/runtime affordances. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public types carry XML docs; do not fail the build for undocumented members
         (properties, overloads) where the type-level summary already conveys intent. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- IsExternalInit polyfill so `record` / `init` compile on netstandard2.0. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../build/Polyfills.cs" Link="Polyfills.cs" />
  </ItemGroup>
</Project>
