<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FluentPdf.Application</RootNamespace>
    <AssemblyName>FluentPdf.Application</AssemblyName>
    <!-- The main entry package consumers reference (directly, or transitively via an adapter). -->
    <PackageId>FluentPdf</PackageId>
    <Description>FluentPdf — a library-agnostic fluent builder for PDF documents (document model, fluent API, IPdfRenderer/ITextMeasurer ports, streaming paginator). Add a renderer adapter (e.g. FluentPdf.Adapters.QuestPdf or FluentPdf.Adapters.iText) to emit PDFs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FluentPdf.Domain/FluentPdf.Domain.csproj" />
    <ProjectReference Include="../FluentPdf.Kernel/FluentPdf.Kernel.csproj" />
  </ItemGroup>

  <!-- Span<T> is intrinsic on net8.0+; on netstandard2.0 it ships in System.Memory. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

</Project>
