<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FluentPdf.Infrastructure</RootNamespace>
    <AssemblyName>FluentPdf.Infrastructure</AssemblyName>
    <Description>Built-in adapters for FluentPdf, including an in-memory reference renderer that proves the agnostic model without depending on any third-party PDF library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application is the 'FluentPdf' package; Domain/Kernel come through it (bundled inside). -->
    <ProjectReference Include="../FluentPdf.Application/FluentPdf.Application.csproj" />
  </ItemGroup>

</Project>
