<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/FluentPdf.Conformance/FluentPdf.Conformance.csproj" />
    <ProjectReference Include="../../adapters/FluentPdf.Adapters.QuestPdf/FluentPdf.Adapters.QuestPdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read-only text extraction from the rendered bytes for the contract assertions. -->
    <PackageReference Include="itext7" />
  </ItemGroup>

  <!-- On the 2023 line QuestPDF does not bring the SkiaSharp/HarfBuzz Linux native assets (it
       expects the host to add them); 2024 bundles them, so nothing is needed by default. This
       mirrors how iText 8 splits BouncyCastle into a separate package — the package topology,
       not just the version, changes across majors. -->
  <ItemGroup Condition="'$(QuestPdfMajor)' == '2023'">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

</Project>
